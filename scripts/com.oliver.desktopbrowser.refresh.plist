<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oliver.desktopbrowser.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/oliver/Work/antiwork-desktop-browser/scripts/auto-refresh.sh</string>
    </array>

    <!-- Try twice a day; the script itself skips unless the profile is
         5+ days old, so actual reinstalls happen about twice a week. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>10</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/oliver/Library/Logs/DesktopBrowser-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/oliver/Library/Logs/DesktopBrowser-refresh.log</string>
</dict>
</plist>
